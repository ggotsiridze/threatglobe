# Copy to .env to override defaults for `docker compose` / `make demo`.
# Never commit a real .env — it is gitignored.

THREATGLOBE_SOURCE=demo        # demo | tpot (tpot REQUIRES REAL T-POT, not implemented yet)
PUBLIC_MODE=true               # mask IPs/passwords, withhold raw records
DEMO_EVENTS_PER_SECOND=1.2
DEMO_HISTORY_HOURS=6
FRONTEND_PORT=8080
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8080

# Future T-Pot integration (server-side only; never sent to the browser)
# ELASTICSEARCH_URL=https://tpot.example.internal:64297
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_INDEX=logstash-*
